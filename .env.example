# ============================================================
#  Discord AFK Bot — Environment Configuration
# ============================================================

# Your Discord USER token (NOT a bot token)
# How to get it: Open Discord in browser → F12 → Application → 
# Local Storage → discord.com → look for "token"
DISCORD_TOKEN=your_discord_user_token_here

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Your name (used in AI intro messages)
YOUR_NAME=Sahal

# AFK mode: true = bot replies automatically, false = bot is silent
AFK_MODE=true

# Dashboard port for local monitoring
DASHBOARD_PORT=5000

# Vercel Web Dashboard URL (optional - syncs your PC bot with your public Vercel app)
VERCEL_DASHBOARD_URL=https://your-app-name.vercel.app
